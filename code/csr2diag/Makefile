# =========================
# USAGE
# make                     # normal release build, quiet output
# make DEBUG=1             # debug build with -g
# make VERBOSE=1           # show full gcc commands
# make STD=c99              # compile against C99 instead of C11
# make DEBUG=1 VERBOSE=1 STD=gnu11   # combine flags freely
# make clean               # remove object files only
# make fclean              # remove object files + binary
# make re                  # full rebuild\
# =========================

# ============================================================
# Compiler
# ============================================================
CC := gcc

# Configure the following
# ============================================================
TARGET   := bin/csr2diag
SRC_DIR  := src
OBJ_DIR  := obj
MTX_MRKT_DIR := ../mtx_mrkt_csr/include/matrix_market
MTX_MRKT_CSR := ../mtx_mrkt_csr/src

#  Variable holding the source files, used as the prerequisites
#    of the $(TARGET) target below.
SRC_DIRS := $(SRC_DIR) $(MTX_MRKT_DIR) $(MTX_MRKT_CSR)
EXCLUDE_SRCS := $(MTX_MRKT_CSR)/main.c
SRCS := $(filter-out $(EXCLUDE_SRCS),$(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c)))
OBJS := $(addprefix $(OBJ_DIR)/,$(notdir $(SRCS:.c=.o)))
DEPS := $(OBJS:.o=.d)
 
# vpath tells Make where to look for %.c files referenced by the
# pattern rule below, since sources now live in more than one dir.
vpath %.c $(SRC_DIRS)

# ============================================================
#  Variable to change the C standard used
# ============================================================
# Override on the command line, e.g.:  make STD=c99
STD ?= c17

# ============================================================
# Flags
# ============================================================
CFLAGS   := -Wall -Wextra -std=$(STD)
# -MMD creates .d files alongside .o file
# .d files contain Makefile syntax that writes
# out every header file that .o file depends on
#
# -MP creates a phony target for every header listed
#  in the dependency file (this is used to not
#  break the build whenever a header is deleted or renamed
CPPFLAGS := -MMD -MP

# library flags for the linker
# -lm is for the math.h header
LDLIBS := -lm

# ------------------------------------------------------------
# Debug build toggle: make DEBUG=1
# ------------------------------------------------------------
DEBUG ?= 0
ifeq ($(DEBUG),1)
    CFLAGS += -g -O0
else
    CFLAGS += -O2
endif

# ------------------------------------------------------------
# Verbose toggle: make VERBOSE=1
#    When not verbose, commands are hidden and replaced with a
#    short "compiling..." style message.
# ------------------------------------------------------------
VERBOSE ?= 0
ifeq ($(VERBOSE),1)
    Q :=
else
    Q := @
endif

# ============================================================
# Rules
# ============================================================
.PHONY: all clean debug verbose unit_test

all: $(TARGET)

# The link step — $(OBJS) (derived from SRCS) is the prerequisite list.
$(TARGET): $(OBJS)
	$(Q)echo "LD  $@"
	$(Q)$(CC) $(OBJS) -o $@ $(LDLIBS)

# Pattern rule to build objects.
$(OBJ_DIR)/%.o: %.c | $(OBJ_DIR)
	$(Q)echo "CC  $<"
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
# creates $(OBJ_DIR) if needed
$(OBJ_DIR):
	$(Q)mkdir -p $(OBJ_DIR)

# ------------------------------------------------------------
# Clean only the object files (keeps the binary)
# ------------------------------------------------------------
clean:
	$(Q)rm -rf $(OBJ_DIR)

unit_test: CFLAGS += -DUNIT_TEST_CSR2DIAG

unit_test: clean $(OBJS)
	$(Q)$(CC) $(OBJS) -o $@ $(LDLIBS)

# Optional: clean everything including the binary
.PHONY: fclean re
fclean: clean
	$(Q)rm -f $(TARGET)

re: fclean all

# pull in the autogenerated dependency files
-include $(DEPS)
